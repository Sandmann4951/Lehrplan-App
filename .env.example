# Konfiguration für docker compose. Kopieren nach .env und anpassen.
# Enthält bewusst keine Geheimnisse – Administratorzugang wird per Setup-Befehl angelegt.

# --- Netzwerk -------------------------------------------------------------
# Einzelplatz (Standard): nur dieser Rechner erreicht die Anwendung.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000

# LAN-Modus (Mehrbenutzerbetrieb im Schulnetz): erst Zertifikat erzeugen
# (scripts/make-cert.sh), dann die folgenden Zeilen aktivieren.
# BIND_ADDRESS=0.0.0.0
# TLS_CERT_FILE=/certs/server.crt
# TLS_KEY_FILE=/certs/server.key

# --- Sitzung --------------------------------------------------------------
SESSION_HOURS=8
# Wird bei aktivem TLS automatisch gesetzt; nur hinter einem eigenen HTTPS-Proxy manuell auf true setzen.
# COOKIE_SECURE=true

# --- Dateien --------------------------------------------------------------
MAX_UPLOAD_MB=20

# --- Sicherung ------------------------------------------------------------
BACKUP_AUTO=true
BACKUP_TIME=02:30
BACKUP_KEEP=14
